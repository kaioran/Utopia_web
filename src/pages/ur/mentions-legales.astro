---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../config/site.config';

const pageTitle = `قانونی نوٹس • ${siteConfig.brand.name}`;
const pageDesc = "یوٹوپیا پی او ایس اور اسٹیلر سافٹ کی سرکاری قانونی معلومات۔";
---

<BaseLayout locale="ur" title={pageTitle} description={pageDesc}>
  <section class="legal-page-section">
    <div class="legal-container">
      <a href="/ur/" class="back-link">← مرکزی صفحے پر واپس جائیں</a>

      <h1 class="legal-title">قانونی معلومات</h1>
      <p class="legal-meta">ناشر: اسٹیلر سافٹ • سافٹ ویئر: یوٹوپیا پی او ایس</p>

      <div class="legal-content">
        <h2>1. سافٹ ویئر اور ویب سائٹ کا ناشر</h2>
        <p>
          کیش رجسٹر اور ریٹیل مینجمنٹ سافٹ ویئر <strong>یوٹوپیا پی او ایس</strong> اور یہ ویب سائٹ <strong>اسٹیلر سافٹ</strong> کی ملکیت ہیں۔
        </p>
        <ul>
          <li><strong>کمپنی:</strong> اسٹیلر سافٹ</li>
          <li><strong>ای میل:</strong> contact@stellarsoft.com</li>
          <li><strong>واٹس ایپ معاونت:</strong> براہ راست کاروباری و تکنیکی سپورٹ</li>
          <li><strong>آپریٹنگ سسٹم:</strong> ونڈوز 10، ونڈوز 11 (64-بٹ)</li>
        </ul>

        <h2>2. فکری ملکیت اور کاپی رائٹ</h2>
        <p>
          تمام ٹریڈ مارکس، لوگوز، یوزر انٹرفیس ڈیزائنز، سورس کوڈ اور تحریری مواد اسٹیلر سافٹ کی خصوصی ملکیت ہیں۔
        </p>

        <h2>3. آف لائن استعمال اور ذمہ داری</h2>
        <p>
          یوٹوپیا پی او ایس دکان کے کمپیوٹر پر مقامی طور پر خود مختار استعمال کے لیے فراہم کیا جاتا ہے۔ دکاندار اپنے ڈیٹا کے لوکل بیک اپ اور متعلقہ تجارتی قواعد کی پاسداری کا خود ذمہ دار ہے۔
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page-section {
    padding: 4rem 1.5rem 6rem;
    background-color: var(--content-bg);
    color: var(--content-text);
    min-height: 70vh;
  }
  .legal-container {
    max-width: 800px;
    margin: 0 auto;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-cyan);
    font-weight: 700;
    text-decoration: none;
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }
  .back-link:hover {
    text-decoration: underline;
  }
  .legal-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--content-text);
    margin-bottom: 0.5rem;
  }
  .legal-meta {
    font-size: 0.9rem;
    color: var(--content-muted);
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }
  .legal-content h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--content-text);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .legal-content p {
    color: var(--content-text);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .legal-content ul {
    margin-right: 1.5rem;
    margin-bottom: 1.5rem;
    line-height: 1.7;
    color: var(--content-text);
  }
</style>
