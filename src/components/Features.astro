---
import type { SupportedLocale } from '../i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

import ScreenMockup from './ScreenMockup.astro';

const items = [
  { id: 'feature1' as const, data: t.features.item1, iconBg: 'rose-bg', dotColor: 'rose-dot', imageSrc: '/screenshots/credits-clients.png' },
  { id: 'feature2' as const, data: t.features.item2, iconBg: 'cyan-bg', dotColor: 'cyan-dot', imageSrc: '/screenshots/caisse-tactile.png' },
  { id: 'feature3' as const, data: t.features.item3, iconBg: 'amber-bg', dotColor: 'amber-dot', imageSrc: '/screenshots/cloture-z.png' },
  { id: 'feature4' as const, data: t.features.item4, iconBg: 'purple-bg', dotColor: 'purple-dot', imageSrc: '/screenshots/vendeurs-pin.png' },
  { id: 'feature5' as const, data: t.features.item5, iconBg: 'emerald-bg', dotColor: 'emerald-dot', imageSrc: '/screenshots/multi-postes.png' },
];
---

<section class="features-section" id="fonctionnalites" aria-labelledby="features-title">
  <div class="features-container">
    {/* En-tête de section Technova */}
    <div class="section-header reveal">
      <div class="terminal-badge">
        <span class="pulse-dot"></span>
        <span>&gt;_ ./solutions --bento --modules</span>
      </div>
      <h2 class="section-title" id="features-title">
        {t.features.title}
      </h2>
    </div>

    {/* Bento Grid Asymétrique & Vivant */}
    <div class="features-bento-grid reveal-stagger">
      
      {/* 1. CARTE MAÎTRESSE : Caisse Tactile (Hero Card - 8 cols) */}
      <div class="bento-card bento-hero bento-cyan reveal interactive-card">
        <div class="bento-glow cyan-glow" aria-hidden="true"></div>
        <div class="bento-header">
          <div class="bento-badge-row">
            <span class="feature-badge">{items[1].data.badge}</span>
            <span class="feature-dot cyan-dot pulse-beacon"></span>
          </div>
          <h3 class="bento-title">{items[1].data.title}</h3>
          <p class="bento-desc">{items[1].data.desc}</p>
        </div>
        
        {/* Chips de fonctionnalités rapides */}
        <div class="bento-chips-row">
          {items[1].data.points.map((point: string) => (
            <span class="bento-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{point}</span>
            </span>
          ))}
        </div>

        {/* Aperçu Visuel Intégré */}
        <div class="bento-visual">
          <ScreenMockup featureId={items[1].id} locale={locale} imageSrc={items[1].imageSrc} />
        </div>
      </div>

      {/* 2. CARTE VERTICALE : Crédit & Dettes Clients (4 cols) */}
      <div class="bento-card bento-vertical bento-rose reveal interactive-card">
        <div class="bento-glow rose-glow" aria-hidden="true"></div>
        <div class="bento-header">
          <div class="bento-badge-row">
            <span class="feature-badge rose-badge">{items[0].data.badge}</span>
            <span class="feature-dot rose-dot pulse-beacon"></span>
          </div>
          <h3 class="bento-title">{items[0].data.title}</h3>
          <p class="bento-desc">{items[0].data.desc}</p>
        </div>

        <ul class="bento-list">
          {items[0].data.points.map((point: string) => (
            <li>
              <span class="bento-check rose-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span>{point}</span>
            </li>
          ))}
        </ul>

        <div class="bento-visual">
          <ScreenMockup featureId={items[0].id} locale={locale} imageSrc={items[0].imageSrc} />
        </div>
      </div>

      {/* 3. CARTE HORIZONTALE : Clôture Z du Soir (7 cols) */}
      <div class="bento-card bento-medium bento-amber reveal interactive-card">
        <div class="bento-glow amber-glow" aria-hidden="true"></div>
        <div class="bento-header">
          <div class="bento-badge-row">
            <span class="feature-badge amber-badge">{items[2].data.badge}</span>
            <span class="feature-dot amber-dot pulse-beacon"></span>
          </div>
          <h3 class="bento-title">{items[2].data.title}</h3>
          <p class="bento-desc">{items[2].data.desc}</p>
        </div>

        <ul class="bento-list">
          {items[2].data.points.map((point: string) => (
            <li>
              <span class="bento-check amber-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span>{point}</span>
            </li>
          ))}
        </ul>

        <div class="bento-visual">
          <ScreenMockup featureId={items[2].id} locale={locale} imageSrc={items[2].imageSrc} />
        </div>
      </div>

      {/* 4. CARTE COMPACTE : Multi-vendeurs PIN (5 cols) */}
      <div class="bento-card bento-compact bento-purple reveal interactive-card">
        <div class="bento-glow purple-glow" aria-hidden="true"></div>
        <div class="bento-header">
          <div class="bento-badge-row">
            <span class="feature-badge purple-badge">{items[3].data.badge}</span>
            <span class="feature-dot purple-dot pulse-beacon"></span>
          </div>
          <h3 class="bento-title">{items[3].data.title}</h3>
          <p class="bento-desc">{items[3].data.desc}</p>
        </div>

        <ul class="bento-list">
          {items[3].data.points.map((point: string) => (
            <li>
              <span class="bento-check purple-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <span>{point}</span>
            </li>
          ))}
        </ul>

        <div class="bento-visual">
          <ScreenMockup featureId={items[3].id} locale={locale} imageSrc={items[3].imageSrc} />
        </div>
      </div>

      {/* 5. CARTE PANORAMIQUE : Autonomie 100% Hors-Ligne & Réseau LAN (12 cols) */}
      <div class="bento-card bento-full bento-emerald reveal interactive-card">
        <div class="bento-glow emerald-glow" aria-hidden="true"></div>
        <div class="bento-full-grid">
          <div class="bento-header">
            <div class="bento-badge-row">
              <span class="feature-badge emerald-badge">{items[4].data.badge}</span>
              <span class="feature-dot emerald-dot pulse-beacon-emerald"></span>
            </div>
            <h3 class="bento-title">{items[4].data.title}</h3>
            <p class="bento-desc">{items[4].data.desc}</p>

            <ul class="bento-list">
              {items[4].data.points.map((point: string) => (
                <li>
                  <span class="bento-check emerald-check">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="bento-visual">
            <ScreenMockup featureId={items[4].id} locale={locale} imageSrc={items[4].imageSrc} />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 6.5rem 1.5rem;
    background-color: var(--content-bg);
    position: relative;
    transition: background-color var(--transition-normal);
  }

  .features-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--content-text);
    letter-spacing: -0.02em;
    max-width: 800px;
    margin: 0 auto;
  }

  /* Bento Grid Layout */
  .features-bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.75rem;
  }

  .bento-card {
    position: relative;
    background: var(--content-surface);
    border: 1px solid var(--content-border);
    border-radius: var(--radius-2xl);
    padding: 2.25rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
    backdrop-filter: blur(12px);
  }

  :global(html[data-theme="dark"]) .bento-card {
    background: rgba(15, 23, 42, 0.65);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
  }

  .bento-card:hover {
    transform: translateY(-5px);
  }

  /* Responsive column spans */
  @media (max-width: 1024px) {
    .features-bento-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (min-width: 1025px) {
    .bento-hero {
      grid-column: span 8;
    }
    .bento-vertical {
      grid-column: span 4;
    }
    .bento-medium {
      grid-column: span 7;
    }
    .bento-compact {
      grid-column: span 5;
    }
    .bento-full {
      grid-column: span 12;
    }
    .bento-full-grid {
      display: grid;
      grid-template-columns: 1fr 1.25fr;
      gap: 3rem;
      align-items: center;
    }
  }

  /* Halos d'ambiance */
  .bento-glow {
    position: absolute;
    top: 0;
    inset-inline-end: 0;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    opacity: 0.15;
    transition: opacity var(--transition-normal);
  }
  .bento-card:hover .bento-glow {
    opacity: 0.3;
  }

  .cyan-glow { background: #00E5FF; }
  .rose-glow { background: #F43F5E; }
  .amber-glow { background: #F59E0B; }
  .purple-glow { background: #A855F7; }
  .emerald-glow { background: #10B981; }

  /* Hover thématiques */
  .bento-cyan:hover {
    border-color: rgba(0, 229, 255, 0.45);
    box-shadow: 0 15px 40px rgba(0, 229, 255, 0.14);
  }
  .bento-rose:hover {
    border-color: rgba(244, 63, 94, 0.45);
    box-shadow: 0 15px 40px rgba(244, 63, 94, 0.14);
  }
  .bento-amber:hover {
    border-color: rgba(245, 158, 11, 0.45);
    box-shadow: 0 15px 40px rgba(245, 158, 11, 0.14);
  }
  .bento-purple:hover {
    border-color: rgba(168, 85, 247, 0.45);
    box-shadow: 0 15px 40px rgba(168, 85, 247, 0.14);
  }
  .bento-emerald:hover {
    border-color: rgba(16, 185, 129, 0.45);
    box-shadow: 0 15px 40px rgba(16, 185, 129, 0.14);
  }

  /* Badges & Textes */
  .bento-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .feature-badge {
    display: inline-block;
    padding: 0.35rem 0.95rem;
    background: rgba(0, 229, 255, 0.08);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 229, 255, 0.25);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
  }

  .rose-badge {
    background: rgba(244, 63, 94, 0.08);
    color: #F43F5E;
    border-color: rgba(244, 63, 94, 0.25);
  }
  .amber-badge {
    background: rgba(245, 158, 11, 0.08);
    color: #F59E0B;
    border-color: rgba(245, 158, 11, 0.25);
  }
  .purple-badge {
    background: rgba(168, 85, 247, 0.08);
    color: #A855F7;
    border-color: rgba(168, 85, 247, 0.25);
  }
  .emerald-badge {
    background: rgba(16, 185, 129, 0.08);
    color: #10B981;
    border-color: rgba(16, 185, 129, 0.25);
  }

  .feature-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .rose-dot { background: #F43F5E; box-shadow: 0 0 8px #F43F5E; }
  .cyan-dot { background: #00E5FF; box-shadow: 0 0 8px #00E5FF; }
  .amber-dot { background: #F59E0B; box-shadow: 0 0 8px #F59E0B; }
  .purple-dot { background: #A855F7; box-shadow: 0 0 8px #A855F7; }
  .emerald-dot { background: #10B981; box-shadow: 0 0 8px #10B981; }

  .bento-title {
    font-size: 1.65rem;
    font-weight: 900;
    color: var(--content-text);
    line-height: 1.3;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .bento-desc {
    font-size: 0.98rem;
    color: var(--content-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  /* Chips interactifs */
  .bento-chips-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .bento-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    background: rgba(0, 229, 255, 0.06);
    border: 1px solid rgba(0, 229, 255, 0.18);
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--content-text);
  }

  .bento-chip svg {
    color: var(--accent-cyan);
    flex-shrink: 0;
  }

  /* Listes */
  .bento-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .bento-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--content-text-muted);
  }

  .bento-check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .rose-check { background: rgba(244, 63, 94, 0.15); color: #F43F5E; }
  .amber-check { background: rgba(245, 158, 11, 0.15); color: #F59E0B; }
  .purple-check { background: rgba(168, 85, 247, 0.15); color: #A855F7; }
  .emerald-check { background: rgba(16, 185, 129, 0.15); color: #10B981; }

  .bento-visual {
    margin-top: auto;
    width: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .features-section {
      padding: 4rem 1rem;
    }
    .section-title {
      font-size: 1.85rem;
    }
    .bento-card {
      padding: 1.5rem;
    }
    .bento-title {
      font-size: 1.4rem;
    }
  }
</style>
