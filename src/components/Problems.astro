---
import type { SupportedLocale } from '../i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const isAr = locale === 'ar';
const t = getTranslations(locale);

const problemBadgeLabel = isAr ? "المشكلة في المتجر" : (locale === 'tr' ? "Sahadaki Sorun" : (locale === 'de' ? "Das Problem im Laden" : (locale === 'es' ? "El problema en tienda" : (locale === 'it' ? "Il problema in negozio" : (locale === 'en' ? "The Daily Problem" : "Le problème")))));
const solutionBadgeLabel = isAr ? "مع يوتوبيا" : (locale === 'tr' ? "Utopia ile Çözüm" : (locale === 'de' ? "Die Utopia-Lösung" : (locale === 'es' ? "La solución Utopia" : (locale === 'it' ? "La soluzione Utopia" : (locale === 'en' ? "The Utopia Solution" : "La solution Utopia")))));
---

<section class="problems-section" id="problemes" aria-labelledby="problems-title">
  <div class="problems-container">
    {/* En-tête de section Technova */}
    <div class="section-header reveal">
      <div class="terminal-badge">
        <span class="pulse-dot"></span>
        <span>&gt;_ ./diagnostic --terrain</span>
      </div>
      <h2 class="section-title" id="problems-title">
        {t.problems.title}
      </h2>
    </div>

    {/* Grille des 3 problèmes / bénéfices Technova avec cascade échelonnée */}
    <div class="problems-grid reveal-stagger">
      {/* Carte 1 : Créances clients oubliées */}
      <div class="problem-card reveal interactive-card">
        <div class="card-glow-indicator rose-glow pulse-beacon"></div>
        <div class="card-icon-wrapper red-theme">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <h3 class="problem-title">{t.problems.item1.title}</h3>
        <div class="problem-box">
          <span class="box-badge problem-badge">{problemBadgeLabel}</span>
          <p class="problem-text">{t.problems.item1.problem}</p>
        </div>
        <div class="solution-box">
          <span class="box-badge solution-badge">{solutionBadgeLabel}</span>
          <p class="solution-text">{t.problems.item1.solution}</p>
        </div>
      </div>

      {/* Carte 2 : Encaissement ralenti */}
      <div class="problem-card reveal interactive-card">
        <div class="card-glow-indicator amber-glow pulse-beacon"></div>
        <div class="card-icon-wrapper amber-theme">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <h3 class="problem-title">{t.problems.item2.title}</h3>
        <div class="problem-box">
          <span class="box-badge problem-badge">{problemBadgeLabel}</span>
          <p class="problem-text">{t.problems.item2.problem}</p>
        </div>
        <div class="solution-box">
          <span class="box-badge solution-badge">{solutionBadgeLabel}</span>
          <p class="solution-text">{t.problems.item2.solution}</p>
        </div>
      </div>

      {/* Carte 3 : Caisse du soir floue */}
      <div class="problem-card reveal interactive-card">
        <div class="card-glow-indicator cyan-glow pulse-beacon"></div>
        <div class="card-icon-wrapper cyan-theme">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <line x1="6" y1="12" x2="18" y2="12"></line>
            <line x1="6" y1="8" x2="10" y2="8"></line>
            <line x1="6" y1="16" x2="14" y2="16"></line>
          </svg>
        </div>
        <h3 class="problem-title">{t.problems.item3.title}</h3>
        <div class="problem-box">
          <span class="box-badge problem-badge">{problemBadgeLabel}</span>
          <p class="problem-text">{t.problems.item3.problem}</p>
        </div>
        <div class="solution-box">
          <span class="box-badge solution-badge">{solutionBadgeLabel}</span>
          <p class="solution-text">{t.problems.item3.solution}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .problems-section {
    padding: 6rem 1.5rem;
    background-color: var(--content-bg);
    position: relative;
    transition: background-color var(--transition-normal);
  }

  .problems-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--content-text);
    letter-spacing: -0.02em;
    max-width: 800px;
  }

  .problems-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .problems-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .problem-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--radius-xl);
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--card-shadow);
    backdrop-filter: blur(16px);
    position: relative;
    overflow: hidden;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  }

  .problem-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--card-shadow-hover);
    border-color: var(--card-border-hover);
  }

  .card-glow-indicator {
    position: absolute;
    top: 1.5rem;
    inset-inline-end: 1.5rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .rose-glow { background: #F43F5E; box-shadow: 0 0 10px #F43F5E; }
  .amber-glow { background: #F59E0B; box-shadow: 0 0 10px #F59E0B; }
  .cyan-glow { background: #00E5FF; box-shadow: 0 0 10px #00E5FF; }

  .card-icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .red-theme {
    background: rgba(244, 63, 94, 0.12);
    color: #F43F5E;
    border: 1px solid rgba(244, 63, 94, 0.25);
  }

  .amber-theme {
    background: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .cyan-theme {
    background: rgba(0, 229, 255, 0.12);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 229, 255, 0.25);
  }

  .problem-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--content-text);
    margin-bottom: 1.5rem;
    line-height: 1.3;
  }

  .problem-box {
    background: rgba(244, 63, 94, 0.06);
    border-inline-start: 3px solid #F43F5E;
    padding: 0.9rem 1rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-bottom: 1rem;
  }

  [dir="rtl"] .problem-box {
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
  }

  .solution-box {
    background: rgba(16, 185, 129, 0.08);
    border-inline-start: 3px solid #10B981;
    padding: 0.9rem 1rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-top: auto;
  }

  [dir="rtl"] .solution-box {
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
  }

  .box-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
    letter-spacing: 0.04em;
  }

  .problem-badge { color: #F43F5E; }
  .solution-badge { color: #10B981; }

  .problem-text {
    font-size: 0.88rem;
    color: var(--content-text-muted);
    line-height: 1.5;
  }

  .solution-text {
    font-size: 0.88rem;
    color: var(--content-text);
    font-weight: 600;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .problems-section {
      padding: 3.5rem 1rem;
    }
    .section-title {
      font-size: 1.8rem;
    }
  }
</style>
