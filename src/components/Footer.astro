---
import type { SupportedLocale } from '../i18n';
import { getTranslations } from '../i18n';
import { siteConfig } from '../config/site.config';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const isAr = locale === 'ar';
const t = getTranslations(locale);

const cleanPhone = siteConfig.contact.whatsappNumber.replace(/[^0-9]/g, '');
const isUr = locale === 'ur';
const defaultWaMsg = isAr 
  ? siteConfig.contact.whatsappDefaultMessageAr 
  : (isUr ? "السلام علیکم، میں یوٹوپیا پی او ایس کے بارے میں جاننا چاہتا ہوں۔" : siteConfig.contact.whatsappDefaultMessageFr);

const emailUrl = `mailto:${siteConfig.contact.email}`;
const whatsappUrl = cleanPhone.length >= 8
  ? `https://wa.me/${cleanPhone}?text=${encodeURIComponent(defaultWaMsg)}`
  : emailUrl;

const currentYear = new Date().getFullYear();

const navHeadings: Record<string, string> = {
  fr: "Navigation",
  en: "Navigation",
  pt: "Navegação",
  es: "Navegación",
  it: "Navigazione",
  de: "Navigation",
  tr: "Menü",
  ar: "أقسام الموقع",
  ur: "مینو اور لنکس",
  hi: "नेविगेशन",
  bn: "মেনু ও লিংক",
  fil: "Nabigasyon",
};

const contactHeadings: Record<string, string> = {
  fr: "Contact & Accompagnement",
  en: "Contact & Support",
  pt: "Contacto & Suporte",
  es: "Contacto & Soporte",
  it: "Contatto & Supporto",
  de: "Kontakt & Support",
  tr: "İletişim ve Destek",
  ar: "التواصل والدعم",
  ur: "رابطہ اور تعاون",
  hi: "संपर्क और सहायता",
  bn: "যোগাযোগ ও সহায়তা",
  fil: "Kontak at Suporta",
};
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-container">
    {/* Colonne 1 : Marque & Éditeur */}
    <div class="footer-col brand-col">
      <div class="footer-brand">
        <img 
          src="/logo/logo-utopia-transparent.png" 
          alt="Utopia Logo" 
          class="footer-logo logo-light"
          width="40"
          height="40"
          loading="lazy"
        />
        <img 
          src="/logo/logo-utopia-fond-sombre-transparent.png" 
          alt="Utopia Logo" 
          class="footer-logo logo-dark"
          width="40"
          height="40"
          loading="lazy"
        />
        <div>
          <div class="footer-brand-title">Utopia</div>
          <div class="footer-brand-editor">{t.footer.editor || siteConfig.brand.editor}</div>
        </div>
      </div>
      <p class="footer-desc">
        {t.footer.desc}
      </p>
    </div>

    {/* Colonne 2 : Liens rapides & Sections */}
    <div class="footer-col">
      <h3 class="footer-heading">{navHeadings[locale] || navHeadings.fr}</h3>
      <ul class="footer-links">
        <li><a href="#problemes">{t.nav.problems}</a></li>
        <li><a href="#fonctionnalites">{t.nav.features}</a></li>
        <li><a href="#benefices">{t.nav.benefits}</a></li>
        <li><a href="#faq">{t.nav.faq}</a></li>
        <li><a href="#telecharger">{t.nav.downloadCta}</a></li>
      </ul>
    </div>

    {/* Colonne 3 : Contact & Accompagnement */}
    <div class="footer-col">
      <h3 class="footer-heading">{contactHeadings[locale] || contactHeadings.fr}</h3>
      <div class="footer-contact-actions">
        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="contact-badge whatsapp-badge"
          aria-label={t.footer.whatsappSupport}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>{t.footer.whatsappSupport}</span>
        </a>

        <a 
          href={emailUrl} 
          class="contact-badge email-badge"
          aria-label={siteConfig.contact.email}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span>{siteConfig.contact.email}</span>
        </a>
      </div>
    </div>
  </div>

  {/* Sous-pied de page : Droits, Mentions Légales & Confidentialité */}
  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <div class="copyright">
        © {currentYear} {siteConfig.brand.name} ({siteConfig.brand.editor}). {t.footer.rights}
      </div>
      <div class="legal-links">
        <a href={`/${locale}/mentions-legales`}>
          {t.footer.legalNotice}
        </a>
        <span class="sep">•</span>
        <a href={`/${locale}/confidentialite`}>
          {t.footer.privacyPolicy}
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--chrome-bg);
    color: var(--chrome-text-muted);
    border-top: 1px solid var(--chrome-border);
    padding-top: 3.5rem;
    font-size: 0.9rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-container {
      grid-template-columns: 1.6fr 1fr 1.2fr;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .footer-logo {
    height: 38px;
    width: auto;
  }

  .logo-light {
    display: block;
  }
  .logo-dark {
    display: none;
  }

  :global(html[data-theme="dark"]) .logo-light {
    display: none;
  }
  :global(html[data-theme="dark"]) .logo-dark {
    display: block;
  }

  .footer-brand-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--chrome-text);
  }

  .footer-brand-editor {
    font-size: 0.75rem;
    color: var(--accent-cyan);
    font-weight: 700;
    text-transform: uppercase;
  }

  .footer-desc {
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--chrome-text-dim);
    max-width: 380px;
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--chrome-text);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-links a {
    color: var(--chrome-text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--accent-cyan);
  }

  .footer-contact-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-md);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid var(--chrome-border);
    color: var(--chrome-text);
    background: var(--chrome-surface);
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }

  .contact-badge:hover {
    background: var(--chrome-surface-hover);
    transform: translateY(-1px);
  }

  .whatsapp-badge {
    color: #059669;
    border-color: rgba(5, 150, 105, 0.25);
  }

  :global(html[data-theme="dark"]) .whatsapp-badge {
    color: #34D399;
  }

  .email-badge {
    color: var(--accent-cyan);
    border-color: rgba(0, 174, 239, 0.25);
  }

  .footer-bottom {
    border-top: 1px solid var(--chrome-border);
    padding: 1.5rem 0;
    background: var(--chrome-surface-subtle);
  }

  .footer-bottom-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--chrome-text-dim);
  }

  @media (min-width: 640px) {
    .footer-bottom-container {
      flex-direction: row;
    }
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .legal-links a {
    color: var(--chrome-text-dim);
    text-decoration: none;
    transition: color 0.2s;
  }

  .legal-links a:hover {
    color: var(--chrome-text-muted);
  }

  .sep {
    opacity: 0.4;
  }
</style>
