---

<section class="showcase-section" id="galerie-ecrans" aria-labelledby="showcase-title" dir={isAr ? 'rtl' : 'ltr'}>
  {/* Halos d'ambiance Technova */}
  <div class="showcase-glow glow-top" aria-hidden="true"></div>
  <div class="showcase-glow glow-bottom" aria-hidden="true"></div>

  <div class="showcase-container">
    {/* En-tête de section */}
    <div class="section-header reveal">
      <div class="terminal-badge">
        <span class="pulse-dot"></span>
        <span>&gt;_ ./utopia --screens --walkthrough --metiers</span>
      </div>
      <h2 class="section-title" id="showcase-title">
        {isAr ? "استكشف يوتوبيا " : "Explorez Utopia "}
        <span class="text-gradient">{isAr ? "شاشة بشاشة وبكل تفاصيله" : "écran par écran en images réelles"}</span>
      </h2>
      <p class="section-subtitle">
        {isAr 
          ? "جولة استكشافية شاملة: تعرّف على واجهات الكاشير المتخصصة حسب نشاطك التجاري (تجزئة، مطاعم، مخابز، تبغ، جزارة، حلاقة) مع كافة وحدات التسيير والمخزون."
          : "Une visite guidée complète : découvrez les caisses spécialisées par métier (Retail, Restauration, Boulangerie, Tabac, Boucherie, Salon) et les outils de gestion quotidienne."}
      </p>
    </div>

    {/* Filtres par Catégorie de Métiers (Pills) */}
    <div class="category-filters-wrapper reveal">
      <div class="category-filters" role="tablist" aria-label={isAr ? "تصنيفات الشاشات" : "Filtres des écrans"}>
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`category-pill ${idx === 0 ? 'active' : ''}`}
            data-category={cat.key}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            id={`filter-${cat.key}`}
          >
            <span>{isAr ? cat.labelAr : cat.labelFr}</span>
          </button>
        ))}
      </div>
    </div>

    {/* Conteneur Fenêtre Principale / Showcase Tunnel */}
    <div class="showcase-window-wrapper reveal-scale">
      <div class="showcase-window ambient-float">
        {/* Barre de titre Windows / Mac High-Tech */}
        <div class="window-chrome">
          <div class="window-dots" aria-hidden="true">
            <span class="w-dot red"></span>
            <span class="w-dot yellow"></span>
            <span class="w-dot green"></span>
          </div>

          <div class="window-title" id="tunnel-window-title">
            Utopia POS 2026 • {isAr ? screensData[0].titleAr : screensData[0].titleFr}
          </div>

          <div class="window-actions">
            <span class="window-counter" id="tunnel-counter-badge">
              <span id="current-slide-num">01</span> / <span id="total-slides-num">13</span>
            </span>
            <button 
              type="button" 
              class="window-btn-action" 
              id="btn-open-lightbox" 
              title={isAr ? "تكبير بملء الشاشة" : "Agrandir en plein écran"}
              aria-label={isAr ? "تكبير بملء الشاشة" : "Agrandir en plein écran"}
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 3h6v6"></path>
                <path d="M9 21H3v-6"></path>
                <path d="M21 3l-7 7"></path>
                <path d="M3 21l7-7"></path>
              </svg>
              <span class="btn-text-responsive">{isAr ? "ملء الشاشة" : "Plein écran"}</span>
            </button>
          </div>
        </div>

        {/* Corps de la Visionneuse Tunnel */}
        <div class="tunnel-viewport">
          {/* Bouton Précédent */}
          <button 
            type="button" 
            class="tunnel-nav-btn prev-btn" 
            id="tunnel-prev-btn" 
            title={isAr ? "الشاشة السابقة" : "Écran précédent"}
            aria-label={isAr ? "الشاشة السابقة" : "Écran précédent"}
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points={isAr ? "9 18 15 12 9 6" : "15 18 9 12 15 6"}></polyline>
            </svg>
          </button>

          {/* Diaporama des 13 captures d'écran réelles */}
          <div class="tunnel-slides-stage" id="tunnel-slides-stage">
            {screensData.map((screen, idx) => (
              <div
                class={`tunnel-slide ${idx === 0 ? 'active' : ''}`}
                data-slide-index={idx}
                data-category={screen.categoryKey}
                id={`slide-${screen.id}`}
                role="group"
                aria-roledescription="slide"
                aria-label={`${isAr ? screen.titleAr : screen.titleFr} (${idx + 1} / 13)`}
              >
                <div class="slide-image-wrapper">
                  <div class="slide-badge-overlay">
                    <span class="badge-pulse-dot"></span>
                    <span class="badge-text">{isAr ? screen.badgeAr : screen.badgeFr}</span>
                  </div>

                  <img
                    src={screen.file}
                    alt={`${isAr ? screen.titleAr : screen.titleFr} - Utopia POS`}
                    class="screen-real-image"
                    loading={idx === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />

                  <div class="image-zoom-hint" aria-hidden="true">
