    box-shadow: 0 0 10px rgba(0, 229, 255, 0.4);
    transform: translateY(-2px);
  }

  .thumb-btn.is-hidden-category {
    display: none;
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .thumb-index {
    position: absolute;
    bottom: 3px;
    inset-inline-start: 4px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 900;
    color: #FFFFFF;
    background: rgba(0, 0, 0, 0.7);
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
  }

  .thumb-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    transition: background 0.2s ease;
  }

  .thumb-btn.active .thumb-overlay {
    background: transparent;
  }

  /* MODALE LIGHTBOX */
  .showcase-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .showcase-lightbox.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 7, 14, 0.94);
    backdrop-filter: blur(16px);
  }

  .lightbox-dialog {
    position: relative;
    z-index: 10;
    width: 95vw;
    max-width: 1500px;
    height: 92vh;
    display: flex;
    flex-direction: column;
    background: #0B1120;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }

  .lightbox-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    background: rgba(15, 23, 42, 0.9);
    border-bottom: 1px solid var(--chrome-border);
  }

  .lightbox-title-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lightbox-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-cyan);
    background: rgba(0, 229, 255, 0.12);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(0, 229, 255, 0.3);
  }

  .lightbox-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .lightbox-close-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--chrome-border);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .lightbox-close-btn:hover {
    background: #EF4444;
    border-color: #EF4444;
    transform: scale(1.08);
  }

  .lightbox-body {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow: hidden;
    background: #050811;
  }

  .lightbox-image-container {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
  }

  .lightbox-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 5;
  }

  .lightbox-nav-btn:hover {
    background: var(--accent-cyan);
    border-color: var(--accent-cyan);
    color: #050B14;
    transform: translateY(-50%) scale(1.08);
  }

  .lightbox-nav-btn.prev { inset-inline-start: 1.5rem; }
  .lightbox-nav-btn.next { inset-inline-end: 1.5rem; }

  .lightbox-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.5rem;
    background: rgba(15, 23, 42, 0.9);
    border-top: 1px solid var(--chrome-border);
  }

  .lightbox-counter {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-cyan);
    font-size: 0.85rem;
  }

  .lightbox-hint {
    font-size: 0.8rem;
    color: #CBD5E1;
  }

  .is-hidden {
    display: none !important;
  }

  @media (max-width: 768px) {
    .showcase-section {
      padding: 3rem 1rem;
    }
    .section-title {
      font-size: 1.75rem;
    }
    .tunnel-slides-stage {
      aspect-ratio: 4 / 3;
      max-height: 340px;
    }
    .guidance-main-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }
    .guidance-actions-col {
      width: 100%;
      justify-content: space-between;
    }
    .guidance-title {
      font-size: 1rem;
      white-space: normal;
    }
    .tunnel-nav-btn {
      width: 38px;
      height: 38px;
    }
    .btn-text-responsive {
      display: none;
    }
    .keyboard-tip {
      display: none;
    }
  }
</style>

<script is:inline define:vars={{ screensData, isAr }}>
  document.addEventListener('DOMContentLoaded', () => {
    const screens = screensData || [];
    if (!screens.length) return;

    let currentIndex = 0;
    let currentFilter = 'all';
    let isAutoplay = false;
    let autoplayTimer = null;
    let autoplayProgress = 0;
    const AUTOPLAY_DURATION = 5000; // 5 secondes par écran

    // Éléments du DOM
    const slides = Array.from(document.querySelectorAll('.tunnel-slide'));
    const thumbs = Array.from(document.querySelectorAll('.thumb-btn'));
    const filterPills = Array.from(document.querySelectorAll('.category-pill'));
    const prevBtn = document.getElementById('tunnel-prev-btn');
    const nextBtn = document.getElementById('tunnel-next-btn');

    // Éléments d'information
    const windowTitle = document.getElementById('tunnel-window-title');
    const currentNumEl = document.getElementById('current-slide-num');
    const totalNumEl = document.getElementById('total-slides-num');
    const stepPill = document.getElementById('guidance-step-pill');
    const guidanceTitle = document.getElementById('guidance-title');
    const guidanceDesc = document.getElementById('guidance-description');
    const guidanceTags = document.getElementById('guidance-tags');

    // Autoplay
    const autoplayToggleBtn = document.getElementById('btn-autoplay-toggle');
    const iconPlay = document.getElementById('icon-autoplay-play');
    const iconPause = document.getElementById('icon-autoplay-pause');
    const autoplayStatusText = document.getElementById('text-autoplay-status');
    const progressFill = document.getElementById('autoplay-progress-fill');

    // Lightbox
    const lightbox = document.getElementById('showcase-lightbox');
    const lightboxImage = document.getElementById('lightbox-image');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxBadge = document.getElementById('lightbox-badge');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const lightboxCloseBtn = document.getElementById('lightbox-close-btn');
    const lightboxBackdrop = document.getElementById('lightbox-backdrop');
    const lightboxPrevBtn = document.getElementById('lightbox-prev-btn');
    const lightboxNextBtn = document.getElementById('lightbox-next-btn');
    const openLightboxBtn = document.getElementById('btn-open-lightbox');

    function getFilteredIndices() {
      if (currentFilter === 'all') {
        return screens.map((_, i) => i);
      }
      return screens
        .map((s, i) => (s.categoryKey === currentFilter ? i : -1))
        .filter(i => i !== -1);
    }

    function updateGuidance(index) {
      const data = screens[index];
      if (!data) return;

      const title = isAr ? data.titleAr : data.titleFr;
      const desc = isAr ? data.descAr : data.descFr;
      const cat = isAr ? data.categoryAr : data.categoryFr;
      const tags = isAr ? data.tagsAr : data.tagsFr;

      if (windowTitle) {
        windowTitle.textContent = `Utopia POS 2026 • ${title}`;
      }
      if (currentNumEl) {
        currentNumEl.textContent = (index + 1).toString().padStart(2, '0');
      }
      if (totalNumEl) {
        totalNumEl.textContent = screens.length.toString().padStart(2, '0');
      }
      if (stepPill) {
        stepPill.textContent = isAr 
          ? `الشاشة ${(index + 1).toString().padStart(2, '0')} من ${screens.length} • ${cat}`
          : `Écran ${(index + 1).toString().padStart(2, '0')} sur ${screens.length} • ${cat}`;
      }
      if (guidanceTitle) {
        guidanceTitle.textContent = title;
      }
      if (guidanceDesc) {
        guidanceDesc.textContent = desc;
      }
      if (guidanceTags) {
        guidanceTags.innerHTML = tags.map(tag => `
          <span class="feature-tag">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>${tag}</span>
          </span>
        `).join('');
      }
    }

    function goToSlide(newIndex) {
      if (newIndex < 0) newIndex = screens.length - 1;
      if (newIndex >= screens.length) newIndex = 0;

      currentIndex = newIndex;

      // Mettre à jour les slides du carrousel
      slides.forEach((s, idx) => {
        if (idx === currentIndex) {
          s.classList.add('active');
          s.setAttribute('aria-hidden', 'false');
        } else {
          s.classList.remove('active');
          s.setAttribute('aria-hidden', 'true');
        }
      });

      // Mettre à jour les miniatures
      thumbs.forEach((th, idx) => {
        if (idx === currentIndex) {
          th.classList.add('active');
          th.setAttribute('aria-selected', 'true');
          // Faire défiler le conteneur de miniatures pour garder la miniature visible
          th.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          th.classList.remove('active');
          th.setAttribute('aria-selected', 'false');
        }
      });

      updateGuidance(currentIndex);
      resetAutoplayTimer();

      // Si la lightbox est ouverte, mettre à jour son image
      if (lightbox && lightbox.classList.contains('active')) {
        updateLightbox();
      }
    }

    function nextSlide() {
      const filtered = getFilteredIndices();
      const currentPosInFiltered = filtered.indexOf(currentIndex);
      if (currentPosInFiltered === -1 || currentPosInFiltered === filtered.length - 1) {
        goToSlide(filtered[0]);
      } else {
        goToSlide(filtered[currentPosInFiltered + 1]);
      }
    }

    function prevSlide() {
      const filtered = getFilteredIndices();
      const currentPosInFiltered = filtered.indexOf(currentIndex);
      if (currentPosInFiltered <= 0) {
        goToSlide(filtered[filtered.length - 1]);
      } else {
        goToSlide(filtered[currentPosInFiltered - 1]);
      }
    }

    // Gestion de l'Autoplay
    function startAutoplay() {
      isAutoplay = true;
      if (iconPlay) iconPlay.classList.add('is-hidden');
      if (iconPause) iconPause.classList.remove('is-hidden');
      if (autoplayStatusText) {
        autoplayStatusText.textContent = isAr ? "إيقاف مؤقت" : "Pause";
      }
      resetAutoplayTimer();
    }

    function stopAutoplay() {
      isAutoplay = false;
      if (autoplayTimer) clearInterval(autoplayTimer);
      if (iconPlay) iconPlay.classList.remove('is-hidden');
      if (iconPause) iconPause.classList.add('is-hidden');
      if (autoplayStatusText) {
        autoplayStatusText.textContent = isAr ? "تشغيل تلقائي" : "Défilement auto";
      }
      if (progressFill) progressFill.style.width = '0%';
    }

    function resetAutoplayTimer() {
      if (!isAutoplay) return;
      if (autoplayTimer) clearInterval(autoplayTimer);

      autoplayProgress = 0;
      const interval = 50;
      const step = (interval / AUTOPLAY_DURATION) * 100;

      autoplayTimer = setInterval(() => {
        autoplayProgress += step;
        if (progressFill) progressFill.style.width = `${Math.min(autoplayProgress, 100)}%`;

        if (autoplayProgress >= 100) {
          nextSlide();
        }
      }, interval);
    }

    // Gestion Lightbox
    function updateLightbox() {
      const data = screens[currentIndex];
      if (!data) return;
      if (lightboxImage) lightboxImage.src = data.file;
      if (lightboxTitle) lightboxTitle.textContent = isAr ? data.titleAr : data.titleFr;
      if (lightboxBadge) lightboxBadge.textContent = isAr ? data.badgeAr : data.badgeFr;
      if (lightboxCounter) {
        lightboxCounter.textContent = `${(currentIndex + 1).toString().padStart(2, '0')} / ${screens.length.toString().padStart(2, '0')}`;
      }
    }

    function openLightbox() {
      if (!lightbox) return;
      updateLightbox();
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      stopAutoplay();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Événements boutons principaux
    if (prevBtn) prevBtn.addEventListener('click', prevSlide);
    if (nextBtn) nextBtn.addEventListener('click', nextSlide);

    // Clic sur miniature
    thumbs.forEach(th => {
      th.addEventListener('click', () => {
        const target = parseInt(th.getAttribute('data-slide-target') || '0', 10);
        goToSlide(target);
      });
    });

    // Clic sur l'image pour ouvrir en plein écran
    slides.forEach(slide => {
      slide.addEventListener('click', openLightbox);
    });

    if (openLightboxBtn) {
      openLightboxBtn.addEventListener('click', openLightbox);
    }

    // Événements Lightbox
    if (lightboxCloseBtn) lightboxCloseBtn.addEventListener('click', closeLightbox);
    if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);
    if (lightboxPrevBtn) lightboxPrevBtn.addEventListener('click', prevSlide);
    if (lightboxNextBtn) lightboxNextBtn.addEventListener('click', nextSlide);

    // Toggle Autoplay
    if (autoplayToggleBtn) {
      autoplayToggleBtn.addEventListener('click', () => {
        if (isAutoplay) {
          stopAutoplay();
        } else {
          startAutoplay();
        }
      });
    }

    // Filtres Catégories
    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-category') || 'all';
        currentFilter = cat;

        filterPills.forEach(p => {
          p.classList.remove('active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-selected', 'true');

        // Mettre à jour la visibilité des miniatures selon la catégorie
        thumbs.forEach(th => {
          const itemCat = th.getAttribute('data-category');
          if (cat === 'all' || itemCat === cat) {
            th.classList.remove('is-hidden-category');
          } else {
            th.classList.add('is-hidden-category');
          }
        });

        // Naviguer vers le premier écran de la catégorie
        const filtered = getFilteredIndices();
        if (filtered.length > 0 && !filtered.includes(currentIndex)) {
          goToSlide(filtered[0]);
        }
      });
    });

    // Navigation Clavier
    window.addEventListener('keydown', (e) => {
      if (lightbox && lightbox.classList.contains('active')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') isAr ? nextSlide() : prevSlide();
        if (e.key === 'ArrowRight') isAr ? prevSlide() : nextSlide();
        return;
      }

      if (e.key === 'ArrowLeft') {
        isAr ? nextSlide() : prevSlide();
      } else if (e.key === 'ArrowRight') {
        isAr ? prevSlide() : nextSlide();
      } else if (e.key === ' ') {
        // Espace = toggle pause/play quand le showcase est visible
        const rect = document.getElementById('galerie-ecrans')?.getBoundingClientRect();
        if (rect && rect.top < window.innerHeight && rect.bottom > 0) {
          e.preventDefault();
          if (isAutoplay) stopAutoplay(); else startAutoplay();
        }
      }
    });

    // Support du Touch Swipe sur mobile
    const stage = document.getElementById('tunnel-slides-stage');
    if (stage) {
      let touchStartX = 0;
      let touchEndX = 0;

      stage.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      stage.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) {
            isAr ? prevSlide() : nextSlide();
          } else {
            isAr ? nextSlide() : prevSlide();
          }
        }
      }, { passive: true });
    }

    // Initialisation
    updateGuidance(0);
  });
</script>
