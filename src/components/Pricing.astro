---
import type { SupportedLocale } from '../i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const isAr = locale === 'ar';
const t = getTranslations(locale);

import { siteConfig } from '../config/site.config';
const { pricing } = siteConfig;
const currency = isAr ? pricing.currencySymbolAr : pricing.currencySymbolFr;

const badgeSub = isAr 
  ? "دفع لمرة واحدة • 0 اشتراك" 
  : (locale === 'tr' ? "Tek Seferlik Ödeme • 0 Abonelik" 
  : (locale === 'de' ? "Einmalige Zahlung • 0 Abo" 
  : (locale === 'es' ? "Pago único • 0 suscripción" 
  : (locale === 'it' ? "Pagamento unico • 0 abbonamenti" 
  : (locale === 'en' ? "One-Time Payment • 0 Subscription" : "Paiement unique • 0 abonnement")))));

const quoteVal = isAr ? "عرض مخصص" : (locale === 'tr' ? "Özel Teklif" : (locale === 'de' ? "Auf Anfrage" : (locale === 'es' ? "A medida" : (locale === 'it' ? "Su preventivo" : (locale === 'en' ? "Custom Quote" : "Sur Devis")))));
const quoteSub = isAr ? "تسعيرة شفافة حسب حجم متجرك" : (locale === 'tr' ? "Mağazanızın ölçeğine göre şeffaf fiyatlandırma" : (locale === 'de' ? "Transparente Preise passend zu Ihrem Geschäft" : (locale === 'es' ? "Tarifa transparente adaptada a su comercio" : (locale === 'it' ? "Prezzo trasparente su misura per il tuo negozio" : (locale === 'en' ? "Transparent pricing tailored to your store" : "Tarif transparent adapté à votre commerce")))));

const features = [
  t.pricing.feature1,
  t.pricing.feature2,
  t.pricing.feature3,
  t.pricing.feature4,
  t.pricing.feature5,
];
---

<section class="pricing-section" id="tarifs" aria-labelledby="pricing-title">
  {/* Halo lumineux d'ambiance */}
  <div class="pricing-glow" aria-hidden="true"></div>

  <div class="pricing-container">
    <div class="section-header reveal">
      <div class="terminal-badge">
        <span class="pulse-dot"></span>
        <span>&gt;_ ./offre --licence --transparence</span>
      </div>
      <h2 class="section-title" id="pricing-title">{t.pricing.title}</h2>
      <p class="section-subtitle">{t.pricing.subtitle}</p>
    </div>

    <div class="pricing-card-wrapper reveal">
      <div class="pricing-card interactive-card">
        <div class="card-glow-indicator cyan-glow pulse-beacon"></div>
        
        <div class="card-header-badge">
          <span class="pricing-badge">{t.pricing.trialBadge}</span>
          <span class="badge-sub">{badgeSub}</span>
        </div>

        <div class="price-box">
          {pricing.amountDa ? (
            <>
              <span class="price-val">{pricing.amountDa.toLocaleString('fr-FR')}</span>
              <span class="price-currency">{currency}</span>
            </>
          ) : (
            <div class="quote-price-box">
              <span class="price-val quote-val">{quoteVal}</span>
              <span class="quote-sub">{quoteSub}</span>
            </div>
          )}
        </div>

        <p class="price-formula">{isAr ? pricing.offerTypeAr : pricing.offerTypeFr}</p>

        {/* Liste des inclusions clés */}
        <div class="pricing-features-list">
          {features.map((feat) => (
            <div class="feature-row">
              <div class="check-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span class="feature-text">{feat}</span>
            </div>
          ))}
        </div>

        {/* Bouton d'action principal */}
        <div class="pricing-cta-box">
          <a href="#telecharger" class="btn-primary pricing-cta">
            <span>{t.pricing.cta}</span>
          </a>
          <span class="cta-micro-note">
            {isAr ? "تثبيت فوري • بدون التزام • مرافقة شاملة" : "Sans engagement • Démonstration personnalisée • Support inclus"}
          </span>
        </div>

        {/* Note pour réseau ou matériel */}
        <div class="pricing-custom-note">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <p>{t.pricing.customNote}</p>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    position: relative;
    padding: 5rem 1.5rem 5.5rem 1.5rem;
    background-color: var(--content-bg-alt, rgba(16, 22, 30, 0.7));
    overflow: hidden;
    scroll-margin-top: 5.5rem;
  }

  .pricing-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.12), transparent 70%);
    filter: blur(100px);
    pointer-events: none;
  }

  .pricing-container {
    max-width: 820px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
  }

  .terminal-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(6, 182, 212, 0.08);
    border: 1px solid rgba(6, 182, 212, 0.22);
    border-radius: 9999px;
    font-size: 0.8rem;
    font-family: monospace;
    color: #06b6d4;
    margin-bottom: 1rem;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #06b6d4;
    box-shadow: 0 0 8px #06b6d4;
  }

  .section-title {
    font-size: 2.15rem;
    font-weight: 800;
    color: var(--content-text);
    line-height: 1.25;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--content-text-muted);
    line-height: 1.6;
  }

  .pricing-card-wrapper {
    display: flex;
    justify-content: center;
  }

  .pricing-card {
    position: relative;
    width: 100%;
    max-width: 640px;
    background: var(--card-bg, rgba(22, 29, 38, 0.85));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(6, 182, 212, 0.3);
    border-radius: 1.5rem;
    padding: 2.5rem 2.25rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.4), 0 0 35px rgba(6, 182, 212, 0.08);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .pricing-card:hover {
    transform: translateY(-4px);
    border-color: rgba(6, 182, 212, 0.5);
  }

  .card-header-badge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .pricing-badge {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(168, 85, 247, 0.2));
    border: 1px solid rgba(6, 182, 212, 0.4);
    color: #22d3ee;
    letter-spacing: 0.03em;
  }

  .badge-sub {
    font-size: 0.8rem;
    color: var(--content-text-muted);
  }

  .price-box {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .price-val {
    font-size: 3rem;
    font-weight: 900;
    color: var(--content-text);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .quote-price-box {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .quote-val {
    font-size: 2.35rem;
    background: linear-gradient(135deg, #22d3ee, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .quote-sub {
    font-size: 0.9rem;
    color: var(--content-text-muted);
  }

  .price-currency {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--content-text-muted);
  }

  .price-formula {
    font-size: 1rem;
    font-weight: 600;
    color: var(--content-text-muted);
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pricing-features-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .feature-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .check-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #10b981;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-text {
    font-size: 0.95rem;
    color: var(--content-text);
  }

  .pricing-cta-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
  }

  .pricing-cta {
    width: 100%;
    text-align: center;
    padding: 0.85rem 1.5rem;
    font-size: 1rem;
    font-weight: 700;
  }

  .cta-micro-note {
    font-size: 0.78rem;
    color: var(--content-text-muted);
  }

  .pricing-custom-note {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--content-text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .pricing-custom-note svg {
    color: #06b6d4;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
</style>
