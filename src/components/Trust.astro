---
import type { SupportedLocale } from '../i18n';
import { getTranslations } from '../i18n';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const isAr = locale === 'ar';
const t = getTranslations(locale);
---

<section class="trust-section" id="confiance" aria-labelledby="trust-title">
  <div class="trust-container">
    {/* En-tête de section Technova */}
    <div class="section-header reveal">
      <div class="terminal-badge">
        <span class="pulse-dot"></span>
        <span>&gt;_ ./securite --confidentialite --support-local</span>
      </div>
      <h2 class="section-title" id="trust-title">
        {t.trust.title}
      </h2>
      <p class="section-subtitle">
        {t.trust.subtitle}
      </p>
    </div>

    {/* Grille des 3 piliers de confiance */}
    <div class="trust-grid reveal-stagger">
      
      {/* 1. SÉCURITÉ LOCALE */}
      <div class="trust-card reveal interactive-card">
        <div class="card-glow-indicator cyan-glow pulse-beacon"></div>
        <div class="card-header-row">
          <div class="trust-icon-box cyan-theme">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <span class="trust-badge cyan-badge">{t.trust.item1Badge}</span>
        </div>

        <h3 class="trust-card-title">{t.trust.item1Title}</h3>
        <p class="trust-card-desc">{t.trust.item1Desc}</p>

        <ul class="trust-perks-list">
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{isAr ? "بياناتك داخل محلك فقط" : "Données 100% sur votre disque"}</span>
          </li>
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{isAr ? "لا انقطاع مع انقطاع الشبكة" : "Immunisé contre les pannes Internet"}</span>
          </li>
        </ul>
      </div>

      {/* 2. RÔLES ET PERMISSIONS PIN */}
      <div class="trust-card reveal interactive-card">
        <div class="card-glow-indicator purple-glow pulse-beacon"></div>
        <div class="card-header-row">
          <div class="trust-icon-box purple-theme">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <span class="trust-badge purple-badge">{t.trust.item2Badge}</span>
        </div>

        <h3 class="trust-card-title">{t.trust.item2Title}</h3>
        <p class="trust-card-desc">{t.trust.item2Desc}</p>

        <ul class="trust-perks-list">
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{isAr ? "رمز PIN مستقل لكل بائع" : "Code PIN confidentiel par vendeur"}</span>
          </li>
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{isAr ? "توثيق عمليات الإلغاء والتخفيض" : "Journal des annulations et remises"}</span>
          </li>
        </ul>
      </div>

      {/* 3. ACCOMPAGNEMENT STELLARSOFT */}
      <div class="trust-card reveal interactive-card">
        <div class="card-glow-indicator emerald-glow pulse-beacon"></div>
        <div class="card-header-row">
          <div class="trust-icon-box emerald-theme">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <span class="trust-badge emerald-badge">{t.trust.item3Badge}</span>
        </div>

        <h3 class="trust-card-title">{t.trust.item3Title}</h3>
        <p class="trust-card-desc">{t.trust.item3Desc}</p>

        <ul class="trust-perks-list">
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{isAr ? "مساعدة مباشرة عبر واتساب" : "Support réactif sur WhatsApp"}</span>
          </li>
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>{isAr ? "مساعدة في استيراد السلع من إكسيل" : "Importation assistée de vos articles"}</span>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>

<style>
  .trust-section {
    position: relative;
    padding: 5rem 1.5rem 5.5rem 1.5rem;
    background-color: var(--content-bg);
    overflow: hidden;
    scroll-margin-top: 5.5rem;
  }

  .trust-container {
    max-width: 1180px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3.5rem auto;
  }

  .terminal-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.22);
    border-radius: 9999px;
    font-size: 0.8rem;
    font-family: monospace;
    color: #10b981;
    margin-bottom: 1rem;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .section-title {
    font-size: 2.15rem;
    font-weight: 800;
    color: var(--content-text);
    line-height: 1.25;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--content-text-muted);
    line-height: 1.6;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  @media (max-width: 960px) {
    .trust-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .trust-card {
    position: relative;
    background: var(--card-bg, rgba(22, 29, 38, 0.7));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--card-border, rgba(255, 255, 255, 0.08));
    border-radius: 1.25rem;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .trust-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .card-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .trust-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cyan-theme {
    color: #06b6d4;
    background: rgba(6, 182, 212, 0.08);
    border: 1px solid rgba(6, 182, 212, 0.2);
  }

  .purple-theme {
    color: #c084fc;
    background: rgba(168, 85, 247, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.2);
  }

  .emerald-theme {
    color: #34d399;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .trust-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .cyan-badge {
    background: rgba(6, 182, 212, 0.12);
    color: #22d3ee;
    border: 1px solid rgba(6, 182, 212, 0.28);
  }

  .purple-badge {
    background: rgba(168, 85, 247, 0.12);
    color: #d8b4fe;
    border: 1px solid rgba(168, 85, 247, 0.28);
  }

  .emerald-badge {
    background: rgba(16, 185, 129, 0.12);
    color: #6ee7b7;
    border: 1px solid rgba(16, 185, 129, 0.28);
  }

  .trust-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--content-text);
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .trust-card-desc {
    font-size: 0.95rem;
    color: var(--content-text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .trust-perks-list {
    list-style: none;
    padding: 1.25rem 0 0 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .trust-perks-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--content-text-muted);
  }

  .trust-perks-list li svg {
    color: #10b981;
    flex-shrink: 0;
  }
</style>
